import { VerticalBox, HorizontalBox, LineEdit, Button, ListView } from "std-widgets.slint";

struct CategoryModel {
    id: string,
    name: string,
}

struct ItemModel {
    id: string,
    name: string,
    target: string,
    icon-path: string,
}

export component ItemTile inherits Rectangle {
    callback double-clicked();

    in property <ItemModel> item;

    height: 90px;
    width: 80px;

    TouchArea {
        clicked => { root.double-clicked(); }

        VerticalBox {
            padding: 4px;
            spacing: 4px;

            Rectangle {
                width: 64px;
                height: 64px;
                background: #3a3a3a;
                border-radius: 8px;
            }
            Text {
                text: root.item.name;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}

export component ItemGrid inherits Rectangle {
    callback item-double-clicked(index: int);

    in property <[ItemModel]> items;

    ListView {
        for item[index] in items: ItemTile {
            item: item;
            double-clicked => { root.item-double-clicked(index); }
        }
    }
}

export component MainWindow inherits Window {
    title: "GoRun";
    min-width: 800px;
    min-height: 600px;
    width: 800px;
    height: 600px;

    callback search-changed(text: string);
    callback category-selected(index: int);
    callback new-item-clicked();
    callback refresh-icons();
    callback file-dropped(name: string, target: string);
    callback item-double-clicked(index: int);
    callback toggle-view();
    callback toggle-theme();

    property <[CategoryModel]> categories;
    property <[ItemModel]> items;
    property <string> search-text: "";
    property <bool> is-dark-theme: true;
    property <bool> is-icon-view: true;
    property <string> status-text: "Ready";
    property <bool> drop-active: false;

    Rectangle {
        background: root.drop-active ? #204060 : transparent;

        HorizontalBox {
            spacing: 8px;
            padding: 8px;

            // Left sidebar: categories
            VerticalBox {
                width: 160px;
                spacing: 4px;

                Text {
                    text: "Categories";
                    font-size: 14px;
                    font-weight: 700;
                }

                ListView {
                    for cat[index] in categories: Rectangle {
                        height: 32px;
                        background: transparent;
                        TouchArea {
                            clicked => { root.category-selected(index); }
                            Text {
                                text: cat.name;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Button {
                    text: "+ Category";
                    clicked => { root.new-item-clicked(); }
                }
            }

            VerticalBox {
                // Search bar
                HorizontalBox {
                    spacing: 4px;
                    padding: 4px;

                    Rectangle {
                        background: root.is-dark-theme ? #2a2a2a : #f0f0f0;
                        border-radius: 6px;

                        LineEdit {
                            text: root.search-text;
                            edited => { root.search-changed(self.text); }
                        }
                    }
                    Button {
                        text: "New Item";
                        clicked => { root.new-item-clicked(); }
                    }
                    Button {
                        text: root.is-icon-view ? "List" : "Icon";
                        clicked => { root.toggle-view(); }
                    }
                    Button {
                        text: root.is-dark-theme ? "Light" : "Dark";
                        clicked => { root.toggle-theme(); }
                    }
                }

                // Item grid
                ItemGrid {
                    items: root.items;
                    item-double-clicked(index) => { root.item-double-clicked(index); }
                }

                // Status bar
                HorizontalBox {
                    Text {
                        text: root.status-text;
                        font-size: 11px;
                        color: root.is-dark-theme ? #888888 : #666666;
                    }
                }
            }
        }
    }
}
