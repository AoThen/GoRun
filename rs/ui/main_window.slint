import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { CategoryModel, ItemModel } from "models.slint";
import { Sidebar } from "components/sidebar.slint";
import { Toolbar } from "components/toolbar.slint";
import { ItemGrid } from "components/item_grid.slint";
import { ContextMenu } from "components/context_menu.slint";
import { MenuPopup } from "components/menu_popup.slint";
import { Toast } from "components/toast.slint";
import { ConfirmDialog } from "dialogs/confirm_dialog.slint";
import { InputDialog } from "dialogs/input_dialog.slint";
import { AboutDialog } from "dialogs/about_dialog.slint";
import { SettingsDialog } from "dialogs/settings_dialog.slint";

export { CategoryModel, ItemModel }

export component MainWindow inherits Window {
    title: "GoRun";
    // 最小尺寸 360×240：允许自由缩小窗口（原 800×600 下限导致"不能调节大小"）
    min-width: 360px;
    min-height: 240px;
    preferred-width: 800px;
    preferred-height: 600px;

    callback search-changed(text: string);
    callback category-selected(index: int);
    callback new-category();
    callback new-item-clicked();
    callback refresh-icons();

    // v2：汉堡菜单入口与弹层选择（单一入口语义，替代原五组菜单栏）
    in-out property <bool> menu-popup-visible: false;
    in-out property <[string]> menu-popup-items: [];
    // 菜单内容总高（Rust 按 项数×28px + 分隔×1px + padding 8px 计算），
    // 弹层实际高取 min(内容高, 窗口可用高)，矮窗口内滚动
    in-out property <length> menu-popup-content-height: 600px;
    in-out property <[bool]> menu-popup-danger: [];
    callback hamburger-clicked();
    callback menu-popup-selected(index: int);

    in-out property <string> about-version-text: "Version 1.0.0";
    in-out property <string> about-desc-text: "Windows 10+ desktop quick launcher. MIT License.";
    in-out property <string> about-ok-text: "OK";
    in-out property <string> sb-new-item-text: "New Item";
    in-out property <string> sb-search-hint-text: "Search";
    in-out property <string> empty-text: "No items here yet";
    in-out property <string> empty-hint-text: "";
    in-out property <string> confirm-confirm-text: "Delete";
    in-out property <string> confirm-cancel-text: "Cancel";
    in-out property <string> sidebar-title-text: "Categories";
    in-out property <string> sidebar-add-category-text: "+ Category";
    in-out property <int> selected-item-index: 0;
    in-out property <int> sidebar-selected-index: 0;
    in-out property <bool> search-field-focused: false;
    callback file-dropped(name: string, target: string);
    callback item-tile-clicked(index: int);
    callback toggle-view();
    callback toggle-theme();
    callback menu-item-selected(index: int);
    callback hotkey();
    callback item-right-clicked(index: int, x: length, y: length);
    callback background-clicked();
    callback background-right-clicked(x: length, y: length);
    callback category-right-clicked(index: int, x: length, y: length);
    callback escape-pressed();
    callback item-selected();
    callback payload-requested(index: int);
    callback dropped-on(index: int, data: data-transfer);
    callback category-payload-requested(index: int);
    callback category-dropped-on(index: int, data: data-transfer);
    callback wheel-switch(delta: int);

    in-out property <[CategoryModel]> categories;
    in-out property <[ItemModel]> items;
    in-out property <string> search-text: "";
    in-out property <bool> is-dark-theme: false;
    changed is-dark-theme => { Theme.set-dark(root.is-dark-theme); }
    in-out property <bool> is-icon-view: true;

    // v2 Toast（替代 StatusBar）
    in-out property <string> toast-message: "";
    in-out property <bool> toast-error: false;
    in-out property <bool> toast-visible: false;

    // 拖拽排序（F2-1）：drag-payload 由 Rust 设源索引；搜索态禁拖拽（索引语义错位）。
    in-out property <data-transfer> drag-payload;
    in property <bool> drag-enabled: root.search-text == "";

    in-out property <bool> context-menu-visible: false;
    in-out property <[string]> context-menu-items: [];
    // v2：右键菜单危险项标记（平行数组，与 context-menu-items 同长）
    in-out property <[bool]> context-menu-danger: [];

    // 项目集合变化（搜索/换分类/删除）时重置键盘选中项
    changed items => {
        if (root.selected-item-index >= root.items.length) {
            root.selected-item-index = 0;
        }
    }
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    // 右键菜单内容总高（Rust 按 项数×28 + 分隔×1 + padding 8 计算），矮窗口内限高滚动
    in-out property <length> context-menu-content-height: 600px;

    in-out property <bool> confirm-dialog-visible: false;
    in-out property <string> confirm-dialog-title: "Delete Item";
    in-out property <string> confirm-dialog-message: "";
    callback confirm-dialog-ok();
    callback confirm-dialog-cancel();

    in-out property <bool> input-dialog-visible: false;
    in-out property <string> input-dialog-title: "";
    in-out property <string> input-dialog-message: "";
    in-out property <string> input-dialog-text: "";
    in-out property <string> input-dialog-error: "";
    in property <string> input-dialog-confirm-text: "OK";
    in property <string> input-dialog-cancel-text: "Cancel";
    callback input-dialog-ok();
    callback input-dialog-cancel();

    in-out property <bool> about-dialog-visible: false;

    // 设置对话框（V1：背景图）
    in-out property <bool> settings-dialog-visible: false;
    // 对话框文案（Rust 侧本地化注入）
    in property <string> settings-title: "Settings";
    in property <string> settings-bg-label: "Background";
    in property <string> settings-bg-select: "Choose image...";
    in property <string> settings-bg-clear: "Clear";
    in property <string> settings-bg-dim-label: "Dim overlay";
    in property <string> settings-close: "Close";
    // 日志档位（设置项）：文案/选项由 Rust 本地化注入，切换即时生效并持久化
    in property <string> settings-log-label: "Log level";
    in property <[string]> settings-log-model: [];
    in-out property <int> settings-log-index: 0;
    callback settings-log-changed(index: int);
    // 背景图当前状态与遮罩设置（Rust 侧回填/持久化）
    in-out property <string> settings-bg-status: "";
    in-out property <bool> settings-bg-dim-enabled: true;
    in-out property <float> settings-bg-dim-percent: 35;
    callback settings-select-background();
    callback settings-clear-background();
    callback settings-dim-toggled(enabled: bool);
    callback settings-dim-changed(percent: float);
    callback settings-closed();

    // 应用背景图：cover 铺满窗口底层；has-bg-image 为 false 时保持纯色 bg-0
    in property <image> bg-image;
    in property <bool> has-bg-image: false;
    // 暗化遮罩：开关 + 浓度（0.0~1.0，默认 35%），保证图标/文字在壁纸上可读
    in property <bool> bg-dim-enabled: true;
    in property <float> bg-dim: 0.35;

    toggle-view => { is-icon-view = !is-icon-view; }
    toggle-theme => {
        is-dark-theme = !is-dark-theme;
        Theme.set-dark(is-dark-theme);
    }

    Rectangle {
        background: Theme.bg-0;

        // 背景图层（最底层）：cover 铺满；TouchArea 在其上层照常接收点击
        Image {
            visible: root.has-bg-image;
            source: root.bg-image;
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            image-fit: ImageFit.cover;
        }

        // 暗化遮罩层：浓度由设置页滑块控制
        Rectangle {
            visible: root.has-bg-image && root.bg-dim-enabled;
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, root.bg-dim);
        }

        // Background click catcher (bottom layer)
        TouchArea {
            clicked => {
                if (root.context-menu-visible) {
                    root.context-menu-visible = false;
                }
                if (root.menu-popup-visible) {
                    root.menu-popup-visible = false;
                }
            }
            pointer-event(PointerEvent) => {
                if (PointerEvent.button == PointerEventButton.right && PointerEvent.kind == PointerEventKind.down) {
                    root.context-menu-x = self.pressed-x;
                    root.context-menu-y = self.pressed-y;
                    root.context-menu-visible = true;
                    root.background-right-clicked(self.pressed-x, self.pressed-y);
                }
            }
        }

        // Main content (middle layer), wrapped in FocusScope for Escape handling
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    // Esc 分层：先关弹窗/菜单，全部关闭后才清搜索并隐藏窗口
                    if (root.input-dialog-visible) {
                        root.input-dialog-visible = false;
                        root.input-dialog-cancel();
                    } else if (root.confirm-dialog-visible) {
                        root.confirm-dialog-visible = false;
                        root.confirm-dialog-cancel();
                    } else if (root.about-dialog-visible) {
                        root.about-dialog-visible = false;
                    } else if (root.settings-dialog-visible) {
                        root.settings-dialog-visible = false;
                        root.settings-closed();
                    } else if (root.menu-popup-visible) {
                        root.menu-popup-visible = false;
                    } else if (root.context-menu-visible) {
                        root.context-menu-visible = false;
                    } else {
                        root.escape-pressed();
                    }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.selected-item-index < root.items.length - 1) {
                        root.selected-item-index += 1;
                    }
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.selected-item-index > 0) {
                        root.selected-item-index -= 1;
                    }
                    return accept;
                }
                if (event.text == Key.Home) {
                    root.selected-item-index = 0;
                    return accept;
                }
                if (event.text == Key.End) {
                    if (root.items.length > 0) {
                        root.selected-item-index = root.items.length - 1;
                    }
                    return accept;
                }
                if (event.modifiers.control && (event.text == "f" || event.text == "F" || event.text == "\u{6}")) {
                    toolbar.focus-search();
                    return accept;
                }
                if (event.text == Key.Return || event.text == "\u{0d}") {
                    if (root.items.length > 0
                        && !root.search-field-focused
                        && !root.confirm-dialog-visible
                        && !root.input-dialog-visible
                        && !root.about-dialog-visible
                        && !root.context-menu-visible
                        && !root.menu-popup-visible) {
                        root.item-selected();
                    }
                    return accept;
                }
                reject
            }

            VerticalBox {
            spacing: Theme.spacing-sm;
            padding: Theme.spacing-md;

            // v2 工具行（搜索 + 3 图标按钮，替代 MenuBar + SearchBar）
            toolbar := Toolbar {
                has-bg-image: root.has-bg-image;
                text <=> root.search-text;
                field-focused <=> root.search-field-focused;
                search-hint: root.sb-search-hint-text;
                is-icon-view: root.is-icon-view;
                search-changed(text) => {
                    root.context-menu-visible = false;
                    root.search-changed(text);
                }
                toggle-view() => {
                    root.context-menu-visible = false;
                    root.toggle-view();
                }
                toggle-theme() => {
                    root.context-menu-visible = false;
                    root.toggle-theme();
                }
                hamburger-clicked() => {
                    root.context-menu-visible = false;
                    root.menu-popup-visible = !root.menu-popup-visible;
                    root.hamburger-clicked();
                }
            }

            HorizontalBox {
                spacing: Theme.spacing-md;
                padding: Theme.spacing-md;

                Sidebar {
                    has-bg-image: root.has-bg-image;
                    categories: root.categories;
                    selected-index: root.sidebar-selected-index;
                    title-text: root.sidebar-title-text;
                    add-category-text: root.sidebar-add-category-text;
                    category-selected(index) => {
                        root.context-menu-visible = false;
                        root.sidebar-selected-index = index;
                        root.category-selected(index);
                    }
                    category-right-clicked(index, x, y) => {
                        root.context-menu-x = x;
                        root.context-menu-y = y;
                        root.context-menu-visible = true;
                        root.category-right-clicked(index, x, y);
                    }
                    new-category() => {
                        root.context-menu-visible = false;
                        root.new-category();
                    }
                    drag-payload: root.drag-payload;
                    drag-enabled: root.drag-enabled;
                    category-payload-requested(index) => {
                        root.category-payload-requested(index);
                    }
                    category-dropped-on(index, data) => {
                        root.category-dropped-on(index, data);
                    }
                    wheel-switch(delta) => {
                        root.context-menu-visible = false;
                        root.wheel-switch(delta);
                    }
                }

                ItemGrid {
                    horizontal-stretch: 1;
                    items: root.items;
                    is-icon-view: root.is-icon-view;
                    empty-text: root.empty-text;
                    empty-hint-text: root.empty-hint-text;
                    selected-index: root.selected-item-index;
                    drag-payload: root.drag-payload;
                    drag-enabled: root.drag-enabled;
                    item-tile-clicked(index) => {
                        root.context-menu-visible = false;
                        root.selected-item-index = index;
                        root.item-tile-clicked(index);
                    }
                    item-right-clicked(index, x, y) => {
                        root.context-menu-x = x;
                        root.context-menu-y = y;
                        root.context-menu-visible = true;
                        root.item-right-clicked(index, x, y);
                    }
                    payload-requested(index) => {
                        root.payload-requested(index);
                    }
                    dropped-on(index, data) => {
                        root.dropped-on(index, data);
                    }
                }
            }
        }
        }

        // Context menu overlay (top layer)
        ContextMenu {
            visible: root.context-menu-visible;
            x: root.context-menu-x;
            y: root.context-menu-y;
            // 限制在窗口内：锚点下方空间不足时弹层内滚动（对齐 MenuPopup）
            height: min(self.content-height, max(0px, root.height - root.context-menu-y - 8px));
            content-height: root.context-menu-content-height;
            menu-items: root.context-menu-items;
            menu-danger: root.context-menu-danger;
            selected(index) => {
                root.context-menu-visible = false;
                root.menu-item-selected(index);
            }
        }

        // 汉堡弹层（v2：右锚定，消除硬编码组定位）
        MenuPopup {
            visible: root.menu-popup-visible;
            x: max(8px, root.width - self.width - 8px);
            y: 80px;
            // 限制在窗口内：超出部分弹层内滚动（设置等末尾项不再落到窗口外）
            height: min(self.content-height, root.height - 88px);
            content-height: root.menu-popup-content-height;
            items: root.menu-popup-items;
            menu-danger: root.menu-popup-danger;
            selected(index) => {
                root.menu-popup-visible = false;
                root.menu-popup-selected(index);
            }
        }

        // v2 Toast（右下角浮出）
        Toast {
            toast-visible: root.toast-visible;
            message: root.toast-message;
            error: root.toast-error;
        }

        ConfirmDialog {
            dialog-visible: root.confirm-dialog-visible;
            message: root.confirm-dialog-message;
            dialog-title: root.confirm-dialog-title;
            confirm-text: root.confirm-confirm-text;
            cancel-text: root.confirm-cancel-text;
            danger: true;
            confirm() => {
                root.confirm-dialog-visible = false;
                root.confirm-dialog-ok();
            }
            cancel() => {
                root.confirm-dialog-visible = false;
                root.confirm-dialog-cancel();
            }
        }

        InputDialog {
            dialog-visible: root.input-dialog-visible;
            dialog-title: root.input-dialog-title;
            message: root.input-dialog-message;
            input-text: root.input-dialog-text;
            error-message: root.input-dialog-error;
            confirm-text: root.input-dialog-confirm-text;
            cancel-text: root.input-dialog-cancel-text;
            confirm() => {
                root.input-dialog-visible = false;
                root.input-dialog-ok();
            }
            cancel() => {
                root.input-dialog-visible = false;
                root.input-dialog-cancel();
            }
        }

        AboutDialog {
            dialog-visible: root.about-dialog-visible;
            version-text: root.about-version-text;
            desc-text: root.about-desc-text;
            ok-text: root.about-ok-text;
            ok() => {
                root.about-dialog-visible = false;
            }
        }

        SettingsDialog {
            dialog-visible: root.settings-dialog-visible;
            title-text: root.settings-title;
            bg-label: root.settings-bg-label;
            bg-status-text: root.settings-bg-status;
            bg-select-text: root.settings-bg-select;
            bg-clear-text: root.settings-bg-clear;
            bg-dim-label: root.settings-bg-dim-label;
            close-text: root.settings-close;
            log-label: root.settings-log-label;
            log-level-model: root.settings-log-model;
            log-level-index: root.settings-log-index;
            has-background: root.has-bg-image;
            bg-dim-enabled: root.settings-bg-dim-enabled;
            bg-dim-percent: root.settings-bg-dim-percent;
            select-background() => {
                root.settings-select-background();
            }
            clear-background() => {
                root.settings-clear-background();
            }
            dim-toggled(v) => {
                root.settings-bg-dim-enabled = v;
                root.settings-dim-toggled(v);
            }
            dim-changed(v) => {
                root.settings-bg-dim-percent = v;
                root.settings-dim-changed(v);
            }
            log-level-changed(i) => {
                root.settings-log-index = i;
                root.settings-log-changed(i);
            }
            close() => {
                root.settings-dialog-visible = false;
                root.settings-closed();
            }
        }
    }
}
