import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { SearchBar } from "components/search_bar.slint";
import { ItemGrid } from "components/item_grid.slint";
import { StatusBar } from "components/status_bar.slint";
import { ContextMenu } from "components/context_menu.slint";
import { EditDialog } from "edit_dialog.slint";

struct CategoryModel {
    id: string,
    name: string,
}

struct ItemModel {
    id: string,
    name: string,
    target: string,
    icon-path: string,
}

export component MainWindow inherits Window {
    title: "GoRun";
    min-width: 800px;
    min-height: 600px;
    preferred-width: 800px;
    preferred-height: 600px;

    callback search-changed(text: string);
    callback category-selected(index: int);
    callback new-item-clicked();
    callback refresh-icons();
    callback file-dropped(name: string, target: string);
    callback item-double-clicked(index: int);
    callback toggle-view();
    callback toggle-theme();
    callback menu-item-selected(index: int);
    callback item-right-clicked(index: int, x: length, y: length);
    callback background-clicked();

    in-out property <[CategoryModel]> categories;
    in-out property <[ItemModel]> items;
    in-out property <string> search-text: "";
    in-out property <bool> is-dark-theme: true;
    in-out property <bool> is-icon-view: true;
    in-out property <string> status-text: "Ready";
    in-out property <bool> drop-active: false;

    in-out property <bool> context-menu-visible: false;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in-out property <[string]> context-menu-items: [];

    toggle-view => { is-icon-view = !is-icon-view; }
toggle-theme => {
    is-dark-theme = !is-dark-theme;
    Theme.set-dark(is-dark-theme);
}

    Rectangle {
        background: root.drop-active ? Theme.drop-highlight : Theme.bg-primary;

        // Background click catcher (bottom layer)
        TouchArea {
            clicked => {
                if (root.context-menu-visible) {
                    root.context-menu-visible = false;
                }
            }
        }

        // Main content (middle layer)
        HorizontalBox {
            spacing: Theme.spacing-md;
            padding: Theme.spacing-md;

            Sidebar {
                categories: root.categories;
                category-selected(index) => {
                    root.context-menu-visible = false;
                    root.category-selected(index);
                }
            }

            VerticalBox {
                spacing: Theme.spacing-sm;

                SearchBar {
                    text: root.search-text;
                    is-dark-theme: root.is-dark-theme;
                    is-icon-view: root.is-icon-view;
                    search-changed(text) => {
                        root.context-menu-visible = false;
                        root.search-changed(text);
                    }
                    toggle-view() => {
                        root.context-menu-visible = false;
                        root.toggle-view();
                    }
                    toggle-theme() => {
                        root.context-menu-visible = false;
                        root.toggle-theme();
                    }
                    new-item-clicked() => {
                        root.context-menu-visible = false;
                        root.new-item-clicked();
                    }
                }

                ItemGrid {
                    items: root.items;
                    item-double-clicked(index) => {
                        root.context-menu-visible = false;
                        root.item-double-clicked(index);
                    }
                    item-right-clicked(index, x, y) => {
                        root.context-menu-x = x;
                        root.context-menu-y = y;
                        root.context-menu-visible = true;
                        root.item-right-clicked(index, x, y);
                    }
                }

                StatusBar {
                    text: root.status-text;
                    is-dark-theme: root.is-dark-theme;
                }
            }
        }

        // Context menu overlay (top layer)
        ContextMenu {
            visible: root.context-menu-visible;
            x: root.context-menu-x;
            y: root.context-menu-y;
            menu-items: root.context-menu-items;
            selected(index) => {
                root.context-menu-visible = false;
                root.menu-item-selected(index);
            }
        }
    }
}