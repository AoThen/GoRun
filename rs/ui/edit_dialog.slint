import { VerticalBox, HorizontalBox, LineEdit, Button, CheckBox, ComboBox, Text } from "std-widgets.slint";

export component EditDialog inherits Window {
    title: "Edit Item";
    min-width: 450px;
    min-height: 400px;
    width: 500px;
    height: 450px;
    modal: true;

    callback save();
    callback cancel();
    callback browse-target();
    callback browse-icon();

    property <string> item-name;
    property <string> item-target;
    property <string> item-arguments;
    property <string> item-working-dir;
    property <string> item-icon-path;
    property <int> item-icon-index: 0;
    property <string> item-keywords;
    property <string> item-remark;
    property <bool> run-as-admin;
    property <[string]> category-names;
    property <int> selected-category-index: 0;
    property <string> error-message: "";

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalBox {
            alignment: center;
            Text { text: "Name:"; width: 80px; }
            LineEdit {
                text: root.item-name;
                text-changed => { root.item-name = self.text; }
            }
        }

        HorizontalBox {
            alignment: center;
            Text { text: "Target:"; width: 80px; }
            LineEdit {
                text: root.item-target;
                text-changed => { root.item-target = self.text; }
            }
            Button {
                text: "Browse...";
                clicked => { root.browse-target(); }
                width: 80px;
            }
        }

        HorizontalBox {
            alignment: center;
            Text { text: "Arguments:"; width: 80px; }
            LineEdit {
                text: root.item-arguments;
                text-changed => { root.item-arguments = self.text; }
            }
        }

        HorizontalBox {
            alignment: center;
            Text { text: "Directory:"; width: 80px; }
            LineEdit {
                text: root.item-working-dir;
                text-changed => { root.item-working-dir = self.text; }
            }
        }

        HorizontalBox {
            alignment: center;
            Text { text: "Icon Path:"; width: 80px; }
            LineEdit {
                text: root.item-icon-path;
                text-changed => { root.item-icon-path = self.text; }
            }
            Button {
                text: "Browse...";
                clicked => { root.browse-icon(); }
                width: 80px;
            }
        }

        HorizontalBox {
            alignment: center;
            Text { text: "Keywords:"; width: 80px; }
            LineEdit {
                text: root.item-keywords;
                text-changed => { root.item-keywords = self.text; }
            }
        }

        HorizontalBox {
            alignment: center;
            Text { text: "Remark:"; width: 80px; }
            LineEdit {
                text: root.item-remark;
                text-changed => { root.item-remark = self.text; }
            }
        }

        HorizontalBox {
            alignment: center;
            Text { text: "Category:"; width: 80px; }
            ComboBox {
                model: root.category-names;
                current-index: root.selected-category-index;
                selected => {
                    root.selected-category-index = self.current-index;
                }
            }
        }

        HorizontalBox {
            CheckBox {
                text: "Run as administrator";
                checked: root.run-as-admin;
                toggled => { root.run-as-admin = self.checked; }
            }
        }

        if root.error-message != "": HorizontalBox {
            Text {
                text: root.error-message;
                color: #FF0000;
            }
        }

        HorizontalBox {
            alignment: end;
            spacing: 8px;
            height: 36px;
            Button {
                text: "Save";
                clicked => { root.save(); }
            }
            Button { text: "Cancel"; clicked => { root.cancel(); } }
        }
    }
}
