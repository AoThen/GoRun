import { Theme } from "../theme.slint";
import { ItemModel } from "item_tile.slint";
import { ContextMenu, MenuItem } from "context_menu.slint";

export component ItemList {
    in-out property <[ItemModel]> items;
    in-out property <[MenuItem]> context-items;
    in-out property <bool> context-open;
    in-out property <length> context-x;
    in-out property <length> context-y;
    in-out property <int> context-item-idx: -1;

    callback item-double-clicked(int);
    callback context-selected(int);

    ListView {
        for item[idx] in items: Rectangle {
            height: 44px;
            background: idx == root.context-item-idx || row-ta.has-hover
                ? Theme.current.bg-hover
                : transparent;
            border-radius: 6px;

            animate background { duration: 100ms; }

            TouchArea {
                double-click => { root.item-double-clicked(idx); }

                pointer-event(event) => {
                    if (event.button == 0x02 && event.kind == 0x01) {
                        root.context-item-idx = idx;
                        root.context-x = event.x;
                        root.context-y = event.y;
                        root.context-open = true;
                    }
                }

                HorizontalBox {
                    padding: 6px 12px;
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: item.icon-path != ""
                            ? transparent
                            : Theme.current.bg-input;
                        border-radius: 6px;

                        if item.icon-path != "" : Image {
                            source: item.icon-path;
                            width: 28px;
                            height: 28px;
                            x: (parent.width - 28px) / 2;
                            y: (parent.height - 28px) / 2;
                        }

                        if item.icon-path == "" : Text {
                            text: item.name.length > 0 ? item.name.substring(0, 1) : "?";
                            color: Theme.current.text-secondary;
                            font-size: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalBox {
                        spacing: 2px;
                        Text {
                            text: item.name;
                            color: Theme.current.text-primary;
                            font-size: 13px;
                        }
                        Text {
                            text: item.target;
                            color: Theme.current.text-disabled;
                            font-size: 11px;
                            overflow: elide;
                            width: 300px;
                        }
                    }
                }
            }
        }
    }

    ContextMenu {
        items: root.context-items;
        menu-open: root.context-open;
        menu-x: root.context-x;
        menu-y: root.context-y;
        selected(idx) => {
            root.context-open = false;
            root.context-selected(idx);
        }
    }
}
