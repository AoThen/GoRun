import { Theme } from "../theme.slint";
import { ContextMenu, MenuItem } from "context_menu.slint";

export component CategoryPanel {
    in-out property <[string]> categories;
    in-out property <int> selected-index: -1;
    in-out property <[MenuItem]> context-items;
    in-out property <bool> context-open;
    in-out property <length> context-x;
    in-out property <length> context-y;

    callback selected(int);
    callback add-category();
    callback context-selected(int);

    width: 160px;

    Rectangle {
        background: Theme.current.bg-surface;
        border-radius: 0px;

        VerticalBox {
            spacing: 2px;
            padding: 8px;

            Rectangle {
                height: 28px;
                HorizontalBox {
                    padding: 4px 8px;
                    Text {
                        text: "分类";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.current.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            ListView {
                width: 100%;

                for cat[idx] in categories: Rectangle {
                    height: 32px;
                    background: idx == root.selected-index
                        ? Theme.current.bg-selected
                        : (item-ta.has-hover ? Theme.current.bg-hover : transparent);
                    border-radius: 6px;

                    TouchArea {
                        accepted-buttons: left;
                        clicked => { root.selected(idx); root.selected-index = idx; }

                        property <bool> is-context;

                        pointer-event(event) => {
                            if (event.button == 0x02 && event.kind == 0x01) {
                                self.is-context = true;
                                root.context-x = event.x;
                                root.context-y = event.y;
                                root.context-items = [
                                    { id: 0, text: "重命名", enabled: true, separator: false, danger: false },
                                    { id: 1, text: "删除分类", enabled: true, separator: true, danger: true },
                                ];
                                root.context-open = true;
                            }
                        }

                        HorizontalBox {
                            padding: 6px 10px;
                            spacing: 8px;
                            Text {
                                text: "📁";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: cat;
                                color: idx == root.selected-index
                                    ? Theme.current.accent
                                    : Theme.current.text-primary;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.current.border;
            }

            TouchArea {
                height: 36px;
                clicked => { root.add-category(); }
                Rectangle {
                    background: ta.has-hover ? Theme.current.bg-hover : transparent;
                    border-radius: 6px;
                    HorizontalBox {
                        padding: 6px 10px;
                        spacing: 8px;
                        Text { text: "＋"; font-size: 14px; color: Theme.current.text-secondary; }
                        Text { text: "添加分类"; font-size: 13px; color: Theme.current.text-secondary; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    ContextMenu {
        items: root.context-items;
        menu-open: root.context-open;
        menu-x: root.context-x;
        menu-y: root.context-y;
        selected(idx) => {
            root.context-open = false;
            if idx == 0 { root.context-selected(0); }
            else if idx == 1 { root.context-selected(1); }
        }
    }
}
