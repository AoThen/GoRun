import { Theme } from "../theme.slint";
import { ItemTile, ItemModel } from "item_tile.slint";
import { ContextMenu, MenuItem } from "context_menu.slint";

export struct GridRow {
    cols: int,
    col0: ItemModel,
    col1: ItemModel,
    col2: ItemModel,
    col3: ItemModel,
    col4: ItemModel,
    col5: ItemModel,
    col6: ItemModel,
    col7: ItemModel,
}

export component ItemGrid {
    in-out property <[GridRow]> rows;
    in-out property <[MenuItem]> context-items;
    in-out property <bool> context-open;
    in-out property <length> context-x;
    in-out property <length> context-y;
    in-out property <int> context-item-idx: -1;

    callback item-double-clicked(int);
    callback context-selected(int);

    ListView {
        for row[r_idx] in rows: HorizontalBox {
            spacing: 8px;
            padding: 4px 8px;
            height: 100px;

            if row.cols >= 1: ItemTile {
                item: row.col0;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 0); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 0;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
            if row.cols >= 2: ItemTile {
                item: row.col1;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 1); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 1;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
            if row.cols >= 3: ItemTile {
                item: row.col2;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 2); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 2;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
            if row.cols >= 4: ItemTile {
                item: row.col3;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 3); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 3;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
            if row.cols >= 5: ItemTile {
                item: row.col4;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 4); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 4;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
            if row.cols >= 6: ItemTile {
                item: row.col5;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 5); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 5;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
            if row.cols >= 7: ItemTile {
                item: row.col6;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 6); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 6;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
            if row.cols >= 8: ItemTile {
                item: row.col7;
                double-clicked => { root.item-double-clicked(r_idx * 8 + 7); }
                context-menu(idx, x, y) => {
                    root.context-item-idx = r_idx * 8 + 7;
                    root.context-x = x;
                    root.context-y = y;
                    root.context-open = true;
                }
            }
        }
    }

    ContextMenu {
        items: root.context-items;
        menu-open: root.context-open;
        menu-x: root.context-x;
        menu-y: root.context-y;
        selected(idx) => {
            root.context-open = false;
            root.context-selected(idx);
        }
    }
}
