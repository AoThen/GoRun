import { Theme } from "../theme.slint";
import { VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

export component RenameDialog {
    in-out property <bool> dialog-visible;
    in property <string> dialog-title: "重命名";
    in-out property <string> current-name: "";

    callback confirm(string);
    callback cancel();

    visible: root.dialog-visible;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 320px;
            height: 150px;
            background: Theme.current.bg-surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.current.border;

            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalBox {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: root.dialog-title;
                    color: Theme.current.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                LineEdit {
                    text: root.current-name;
                    width: 100%;
                    placeholder-text: "输入新名称...";
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 8px;

                    cancel-ta := TouchArea {
                        width: 80px;
                        height: 32px;
                        clicked => { root.cancel(); root.dialog-visible = false; }
                        Rectangle {
                            background: cancel-ta.has-hover ? Theme.current.bg-hover : transparent;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.current.border;
                            HorizontalBox { alignment: center;
                                Text { text: "取消"; color: Theme.current.text-primary; font-size: 13px; }
                            }
                        }
                    }

                    confirm-ta := TouchArea {
                        width: 80px;
                        height: 32px;
                        clicked => { root.confirm(root.current-name); root.dialog-visible = false; }
                        Rectangle {
                            background: Theme.current.accent;
                            border-radius: 6px;
                            HorizontalBox { alignment: center;
                                Text { text: "确认"; color: #ffffff; font-size: 13px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
