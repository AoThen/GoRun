import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 关于对话框（普通覆盖层组件，模式同 ConfirmDialog）
export component AboutDialog {
    in-out property <bool> dialog-visible;
    in property <string> version-text: "Version 1.0.0";
    in property <string> desc-text: "Windows 10+ desktop quick launcher. MIT License.";
    in property <string> ok-text: "OK";
    callback ok();

    visible: root.dialog-visible;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000060;

        // 遮罩吞点击：铺满后防止鼠标事件穿透到下层（误触启动条目/关闭弹层）。
        // 仅吞不关——关闭由 OK 按钮或 Esc 负责（保守，防误触丢数据）。
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { }
            scroll-event(event) => { accept }
            // 吞掉右键，防穿透到底层触发右键菜单
            pointer-event(PointerEvent) => { EventResult.accept }
        }

        Rectangle {
            // 小窗口自适应：卡片不超过窗口的 92%，避免按钮/内容被裁出窗外
            width: min(380px, root.width * 0.92);
            height: min(max(self.preferred-height, 160px), root.height * 0.92);
            background: Theme.bg-2;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.stroke-1;

            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "GoRun";
                    color: Theme.text-1;
                    font-size: Theme.font-size-lg;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.version-text;
                    color: Theme.text-2;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.desc-text;
                    color: Theme.text-2;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    alignment: center;

                    ok-ta := TouchArea {
                        width: 80px;
                        height: 32px;
                        clicked => { root.ok(); }
                        Rectangle {
                            background: ok-ta.has-hover ? Theme.hover : Theme.accent;
                            border-radius: Theme.radius-xs;
                            HorizontalBox { alignment: center;
                                Text { text: root.ok-text; color: Theme.accent-fg; font-size: 13px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
