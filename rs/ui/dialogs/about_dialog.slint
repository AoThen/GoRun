import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 关于对话框（普通覆盖层组件，模式同 ConfirmDialog）
export component AboutDialog {
    in-out property <bool> dialog-visible;
    in property <string> version-text: "Version 1.0.0";
    in property <string> desc-text: "Windows 10+ desktop quick launcher. MIT License.";
    in property <string> ok-text: "OK";
    callback ok();

    visible: root.dialog-visible;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 380px;
            height: 200px;
            background: Theme.bg-2;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.stroke-1;

            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "GoRun";
                    color: Theme.text-1;
                    font-size: Theme.font-size-lg;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.version-text;
                    color: Theme.text-2;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.desc-text;
                    color: Theme.text-2;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    alignment: center;

                    ok-ta := TouchArea {
                        width: 80px;
                        height: 32px;
                        clicked => { root.ok(); }
                        Rectangle {
                            background: ok-ta.has-hover ? Theme.hover : Theme.accent;
                            border-radius: Theme.radius-xs;
                            HorizontalBox { alignment: center;
                                Text { text: root.ok-text; color: Theme.accent-fg; font-size: 13px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
