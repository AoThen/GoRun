import { Theme } from "../theme.slint";
import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export component ConfirmDialog {
    in-out property <bool> dialog-visible;
    in property <string> dialog-title: "确认";
    in property <string> message: "";
    in property <string> confirm-text: "确定";
    in property <string> cancel-text: "取消";
    in property <bool> danger: false;

    callback confirm();
    callback cancel();

    visible: root.dialog-visible;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000060;

        Rectangle {
            width: 340px;
            min-height: 160px;
            background: Theme.bg-2;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.stroke-1;

            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalBox {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: root.dialog-title;
                    color: Theme.text-1;
                    font-size: Theme.font-size-lg;
                    font-weight: 700;
                }

                Text {
                    text: root.message;
                    color: Theme.text-2;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 8px;

                    cancel-ta := TouchArea {
                        width: 80px;
                        height: 32px;
                        clicked => { root.cancel(); }
                        Rectangle {
                            background: cancel-ta.has-hover ? Theme.hover : transparent;
                            border-radius: Theme.radius-xs;
                            border-width: 1px;
                            border-color: Theme.stroke-2;
                            HorizontalBox { alignment: center;
                                Text { text: root.cancel-text; color: Theme.text-1; font-size: 13px; }
                            }
                        }
                    }

                    confirm-ta := TouchArea {
                        width: 80px;
                        height: 32px;
                        clicked => { root.confirm(); }
                        Rectangle {
                            background: root.danger ? Theme.danger : Theme.accent;
                            border-radius: Theme.radius-xs;
                            HorizontalBox { alignment: center;
                                Text { text: root.confirm-text; color: root.danger ? Theme.danger-fg : Theme.accent-fg; font-size: 13px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
