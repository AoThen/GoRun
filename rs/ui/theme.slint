export struct ThemeColors {
    bg-window: color,
    bg-surface: color,
    bg-hover: color,
    bg-selected: color,
    bg-input: color,
    text-primary: color,
    text-secondary: color,
    text-disabled: color,
    border: color,
    border-focus: color,
    accent: color,
    accent-hover: color,
    danger: color,
    shadow: color,
}

export global Theme {
    in-out property <bool> is-dark: true;
    in-out property <ThemeColors> current: ThemeColors {
        bg-window: #1e1e1e,
        bg-surface: #252526,
        bg-hover: #2a2d2e,
        bg-selected: #37373d,
        bg-input: #3c3c3c,
        text-primary: #cccccc,
        text-secondary: #858585,
        text-disabled: #5a5a5a,
        border: #3c3c3c,
        border-focus: #007acc,
        accent: #0078d4,
        accent-hover: #1e8ad4,
        danger: #e74c3c,
        shadow: #00000040,
    };
    callback toggle();
    callback apply();
}
