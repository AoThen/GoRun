import { HorizontalBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component SearchBar {
    in property <string> text;
    in property <bool> is-dark-theme;
    in-out property <bool> is-icon-view: true;
    in-out property <bool> field-focused: false;
    in property <string> search-hint: "";
    in property <string> new-item-text: "New Item";
    in property <string> switch-list-text: "List";
    in property <string> switch-icon-text: "Icon";
    in property <string> switch-light-text: "Light";
    in property <string> switch-dark-text: "Dark";
    callback search-changed(text: string);
    callback toggle-view();
    callback toggle-theme();
    callback new-item-clicked();

    HorizontalBox {
        spacing: Theme.spacing-sm;
        padding: Theme.spacing-sm;

        Rectangle {
            background: is-dark-theme ? #2a2a2a : #f0f0f0;
            border-radius: Theme.radius-md;

            LineEdit {
                text: root.text;
                placeholder-text: root.search-hint;
                edited => { root.search-changed(self.text); }
                font-size: Theme.font-size-sm;
                changed has-focus => { root.field-focused = self.has-focus; }
            }
        }

        Text {
            text: root.new-item-text;
            color: Theme.accent;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.new-item-clicked(); }
            }
        }

        Text {
            text: root.is-icon-view ? root.switch-list-text : root.switch-icon-text;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.toggle-view(); }
            }
        }

        Text {
            text: root.is-dark-theme ? root.switch-light-text : root.switch-dark-text;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;

            TouchArea {
                clicked => { root.toggle-theme(); }
            }
        }
    }
}