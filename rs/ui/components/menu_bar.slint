import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 顶部菜单栏（P1：五组下拉标题按钮；弹层由 main_window 顶层 MenuPopup 呈现，保证 z-order 高于内容区）
export component MenuBar {
    callback group-clicked(group: int);

    in property <string> title-file: "File";
    in property <string> title-edit: "Edit";
    in property <string> title-view: "View";
    in property <string> title-settings: "Settings";
    in property <string> title-help: "Help";
    in property <length> button-width: 90px;
    in-out property <int> active-group: -1;

    height: 28px;

    HorizontalBox {
        spacing: Theme.spacing-sm;
        padding: 2px;

        Rectangle {
            width: root.button-width;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: btn-file.has-hover || root.active-group == 0 ? Theme.menu-hover : transparent;

            btn-file := TouchArea {
                clicked => { root.group-clicked(0); }
                Text {
                    text: root.title-file;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 100%;
                }
            }
        }

        Rectangle {
            width: root.button-width;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: btn-edit.has-hover || root.active-group == 1 ? Theme.menu-hover : transparent;

            btn-edit := TouchArea {
                clicked => { root.group-clicked(1); }
                Text {
                    text: root.title-edit;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 100%;
                }
            }
        }

        Rectangle {
            width: root.button-width;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: btn-view.has-hover || root.active-group == 2 ? Theme.menu-hover : transparent;

            btn-view := TouchArea {
                clicked => { root.group-clicked(2); }
                Text {
                    text: root.title-view;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 100%;
                }
            }
        }

        Rectangle {
            width: root.button-width;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: btn-settings.has-hover || root.active-group == 3 ? Theme.menu-hover : transparent;

            btn-settings := TouchArea {
                clicked => { root.group-clicked(3); }
                Text {
                    text: root.title-settings;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 100%;
                }
            }
        }

        Rectangle {
            width: root.button-width;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: btn-help.has-hover || root.active-group == 4 ? Theme.menu-hover : transparent;

            btn-help := TouchArea {
                clicked => { root.group-clicked(4); }
                Text {
                    text: root.title-help;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 100%;
                }
            }
        }
    }
}
