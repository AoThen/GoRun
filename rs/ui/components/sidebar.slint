import { VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

struct CategoryModel {
    id: string,
    name: string,
    count: int,
}

export component Sidebar {
    in property <[CategoryModel]> categories;
    in-out property <int> selected-index: 0;
    in property <string> title-text: "Categories";
    in property <string> add-category-text: "+ Category";
    callback category-selected(index: int);
    callback category-right-clicked(index: int, x: length, y: length);
    callback new-category();
    // 分类拖拽排序（F2-1，DragArea/DropArea）：down 请求设源载荷；被拖入时上报 (target, data)。
    callback category-payload-requested(index: int);
    callback category-dropped-on(index: int, data: data-transfer);
    // 滚轮切页（F7/参考特性）：分类项滚轮 → 上/下一分类
    callback wheel-switch(delta: int);
    in-out property <data-transfer> drag-payload;
    in property <bool> drag-enabled: true;

    width: 180px;

    VerticalBox {
        spacing: Theme.spacing-sm;
        padding: Theme.spacing-md;

        Text {
            text: root.title-text;
            font-size: Theme.font-size-md;
            font-weight: 700;
            color: Theme.text-1;
        }

        ListView {
            for cat[index] in categories: Rectangle {
                height: 32px;
                background: index == root.selected-index ? Theme.accent-subtle : transparent;
                border-radius: Theme.radius-xs;

                DragArea {
                    enabled: root.drag-enabled;
                    data: root.drag-payload;
                    allow-move: true;

                    DropArea {
                        can-drop(event) => {
                            return DragAction.move;
                        }
                        dropped(event) => {
                            root.category-dropped-on(index, event.data);
                            return DragAction.move;
                        }

                        cat-touch := TouchArea {
                            clicked => {
                                root.selected-index = index;
                                root.category-selected(index);
                            }
                            scroll-event(event) => {
                                if (event.delta-y != 0) {
                                    root.wheel-switch(event.delta-y > 0 ? 1 : -1);
                                    accept
                                } else {
                                    reject
                                }
                            }
                            pointer-event(PointerEvent) => {
                                if (PointerEvent.button == PointerEventButton.left && PointerEvent.kind == PointerEventKind.down) {
                                    root.category-payload-requested(index);
                                }
                                if (PointerEvent.button == PointerEventButton.right && PointerEvent.kind == PointerEventKind.down) {
                                    root.selected-index = index;
                                    root.category-right-clicked(index, self.pressed-x, self.pressed-y);
                                }
                            }

                            HorizontalBox {
                                spacing: 0;
                                padding: 0;

                                // 选中指示条（v2：左缘 3px accent）
                                Rectangle {
                                    width: 3px;
                                    height: 100%;
                                    background: index == root.selected-index ? Theme.accent : transparent;
                                }

                                Rectangle {
                                    width: Theme.spacing-md - 3px;
                                    height: 100%;
                                }

                                Text {
                                    text: cat.name;
                                    color: Theme.text-1;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                // 计数徽章（v2：行尾右对齐 11px）
                                Text {
                                    text: cat.count;
                                    color: Theme.text-2;
                                    font-size: Theme.font-size-xs;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.stroke-1;
        }

        // 新建分类行（v2：hover 显底）
        Rectangle {
            height: 32px;
            background: add-cat-touch.has-hover ? Theme.hover : transparent;
            border-radius: Theme.radius-xs;

            add-cat-touch := TouchArea {
                clicked => {
                    root.new-category();
                }

                Text {
                    text: root.add-category-text;
                    font-size: Theme.font-size-sm;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
