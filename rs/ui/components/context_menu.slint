import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 右键菜单（v2）：项高 28px；items 中 "-" 渲染 1px 分隔线；
// menu-danger 平行数组标记危险项（danger 色文字）；弹层视觉 bg-2 + stroke-1 描边（阴影降级）。
export component ContextMenu {
    in property <[string]> menu-items;
    in property <[bool]> menu-danger: [];
    callback selected(index: int);

    width: 160px;

    Rectangle {
        background: Theme.bg-2;
        border-width: 1px;
        border-color: Theme.stroke-1;
        border-radius: Theme.radius-md;
        width: 100%;
        height: 100%;

        VerticalBox {
            spacing: 0px;
            padding: 2px;
            width: 100%;

            for item[index] in root.menu-items:
                if (item == "-") {
                    // 分隔线（v2）：1px stroke-1，不响应点击
                    Rectangle {
                        height: 1px;
                        width: 100%;
                        background: Theme.stroke-1;
                    }
                } else {
                    Rectangle {
                        height: 28px;
                        width: 100%;

                        menu-touch := TouchArea {
                            clicked => { root.selected(index); }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: menu-touch.has-hover ? Theme.hover : transparent;

                                HorizontalBox {
                                    spacing: 0;
                                    padding: 0;

                                    Rectangle {
                                        width: 8px;
                                        height: 100%;
                                    }

                                    Text {
                                        text: item;
                                        font-size: Theme.font-size-sm;
                                        color: (index < root.menu-danger.length && root.menu-danger[index]) ? Theme.danger : Theme.text-1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
        }
    }
}
