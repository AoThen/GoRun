import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// 右键菜单（v2）：项高 28px；items 中 "-" 渲染 1px 分隔线；
// menu-danger 平行数组标记危险项（danger 色文字）；弹层视觉 bg-2 + stroke-1 描边（阴影降级）。
// 高度取内容实际高（ScrollView viewport-height），挂载处再 clamp 到锚点下方窗口可用高——
// 矮窗口内菜单项过多时弹层内滚动，不再被窗口底边裁切（对齐 MenuPopup 处理）。
export component ContextMenu {
    in property <[string]> menu-items;
    in property <[bool]> menu-danger: [];
    // 内容总高由 Rust 精确计算注入（项 28px、分隔线 1px、padding 8px，同 MenuPopup），
    // 供挂载处 clamp 到窗口可用高；不能取自 ScrollView 自身（viewport 依赖高度，成环）
    in property <length> content-height: 600px;
    callback selected(index: int);

    width: 160px;
    height: min(self.content-height, 1000px);

    Rectangle {
        background: Theme.bg-2;
        border-width: 1px;
        border-color: Theme.stroke-1;
        border-radius: Theme.radius-md;
        width: 100%;
        height: 100%;

        sv := ScrollView {
            width: 100%;
            height: 100%;

            VerticalBox {
                spacing: 0px;
                padding: 4px;
                width: 100%;

                for item[index] in root.menu-items: Rectangle {
                    // 分隔线（v2）：item == "-" 时渲染 1px stroke-1；否则 28px 菜单项
                    height: item == "-" ? 1px : 28px;
                    width: 100%;
                    background: item == "-" ? Theme.stroke-1 : (menu-touch.has-hover
                        ? ((index < root.menu-danger.length && root.menu-danger[index]) ? Theme.danger-subtle : Theme.hover)
                        : transparent);

                    menu-touch := TouchArea {
                        // 分隔线不响应点击
                        visible: item != "-";
                        clicked => { root.selected(index); }

                        Rectangle {
                            visible: item != "-";
                            width: 100%;
                            height: 100%;
                            background: transparent;

                            HorizontalBox {
                                spacing: 0;
                                padding: 0;

                                Rectangle {
                                    width: 12px;
                                    height: 100%;
                                }

                                Text {
                                    text: item;
                                    font-size: Theme.font-size-md;
                                    color: (index < root.menu-danger.length && root.menu-danger[index]) ? Theme.danger : Theme.text-1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
